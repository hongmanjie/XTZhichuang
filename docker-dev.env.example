DEV_BIND_HOST=127.0.0.1
DEV_PORT=3011
DEV_APP_IMAGE=xtzc-dev-base:local
MODELGATE_BASE=
MODELGATE_API_KEY=
JWT_SECRET=
INDEX_TTS_BASE_URL=
INDEX_TTS_SYNTHESIS_PROVIDER=modelgate

# Optional native multimodal embeddings and lip synchronization; keep endpoints in a trusted network.
EMBEDDING_PROVIDER=modelgate
EMBEDDING_DIRECT_BASE_URL=
EMBEDDING_DIRECT_MODEL=qwen3-vl-embedding-2b
LIPSYNC_PROVIDER=disabled
LIPSYNC_DIRECT_BASE_URL=
LIPSYNC_TIMEOUT_MS=900000

# Video enhancement: modelgate or direct SeedVR2 service.
SUPER_RES_PROVIDER=modelgate
SEEDVR_DIRECT_BASE_URL=
SEEDVR_DIRECT_WAIT_MS=5400000
SEEDVR_DIRECT_CHUNK_FRAMES=6
# Set false only when direct SeedVR2 and LatentSync use separate GPUs.
SEEDVR_LIPSYNC_SHARE_GPU=true

# Video keyframe understanding: disabled, direct, or a compatible future modelgate.
# Direct model endpoints should only be exposed on a trusted network.
VISION_PROVIDER=disabled
VISION_DIRECT_BASE_URL=
VISION_DIRECT_MODEL=Qwen3.6-35B-A3B-FP8
VISION_DIRECT_API_KEY=

# Optional CPU character timing service, reachable only from the trusted network.
ALIGNMENT_PROVIDER=disabled
ALIGN_SERVICE_BASE_URL=
ALIGN_SERVICE_TOKEN=

# Optional H3 coordinator; use one shared private Redis for cooperating app instances.
# Set H3_LOCK_URL=redis://h3-lock:6379 after starting the h3-lock service.
H3_LOCK_URL=
H3_LOCK_KEY=xtzc:h3:generation
