# Copy to .env and provide values locally. Do not commit the real .env.
PORT=3001
NODE_ENV=development
JWT_SECRET=
AI_REAL_ENABLED=true
MODELGATE_ENABLED=true
MODELGATE_BASE=
MODELGATE_API_KEY=
INDEX_TTS_BASE_URL=
INDEX_TTS_SYNTHESIS_PROVIDER=direct
AI_TASK_CONCURRENCY=1
TTS_TASK_CONCURRENCY=1
SUPER_RES_POINTS_PER_SECOND=20
SUBTITLE_TRANSCRIBE_POINTS=10


# Optional native multimodal embeddings and lip synchronization; keep endpoints in a trusted network.
EMBEDDING_PROVIDER=modelgate
EMBEDDING_DIRECT_BASE_URL=
EMBEDDING_DIRECT_MODEL=qwen3-vl-embedding-2b
LIPSYNC_PROVIDER=disabled
LIPSYNC_DIRECT_BASE_URL=
LIPSYNC_TIMEOUT_MS=900000
